#!/usr/bin/env bash

set -e

if [ ! -f .env ]; then
    ./tempest key:generate
fi

{
    echo
    echo '# Werkswind configuration'

    while IFS= read -r line; do
        case "$line" in
            ''|\#*) continue ;;
        esac

        key="${line%%=*}"

        if ! grep -q "^${key}=" .env 2>/dev/null; then
            echo "$line"
        fi
    done < .env.example
} >> .env
